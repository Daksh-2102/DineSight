# DineSight AI - Configuration Variables

# Video Ingestion Settings
# Path to sample video file OR numeric index for webcam (e.g. 0) OR RTSP URL
DEFAULT_VIDEO_SOURCE="data/sample_videos/restaurant_sample.mp4"

# Target Frame Dimensions (Width x Height) for processing and display
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Frame Sampling Rate (Process 1 frame out of every N frames; 1 = process every frame)
FRAME_SKIP_INTERVAL=1

# Playback behavior: True = Loop video continuously; False = Exit when video ends
LOOP_VIDEO=True

# Backend Server Settings (For Phase 4)
API_HOST="127.0.0.1"
API_PORT=8000
DATABASE_URL="sqlite:///./data/dinesight.db"

